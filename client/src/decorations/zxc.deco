// Dead inside: barbed wire stitched along the rim, black and white with
// one drop of red.
name: zxc
order: 140
$wire: #8a8a94
$light: #d4d4d8
$white: #f4f4f5
$red: #e5484d
---
<!-- Two strands crossing each other, so the wire looks twisted. -->
<band d="M@(158,53) A53 53 0 0 1 @(296,53)" color="$wire" width="1.8"/>
<path d="M@(158,53) A53 53 0 0 1 @(296,53)" fill="none" stroke="$light" stroke-width="1.8"
      stroke-dasharray="3 5" stroke-linecap="round"/>
<ring n="10" turn="164" span="126">
  <g transform="translate(@(0,53)) rotate(35)">
    <path d="M0 -4.4V4.4M-4.4 0H4.4" stroke="$ink" stroke-width="3.6" stroke-linecap="round"/>
    <path d="M0 -4.4V4.4M-4.4 0H4.4" stroke="$light" stroke-width="1.3" stroke-linecap="round"/>
  </g>
</ring>
<!-- Where a barb went in. -->
<path d="M@(216,54) q.6 4 0 7.5" stroke="$red" stroke-width="2.2" stroke-linecap="round"/>
<circle cx="23.8" cy="111" r="1.5" fill="$red"/>
