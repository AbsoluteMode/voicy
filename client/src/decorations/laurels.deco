// A ranked look: a gold laurel wreath around the lower half, a medal with a
// star where the branches meet.
name: Лавры
order: 170
$leaf: #ffd84d
$shade: #e0a232
$stem: #b8782a
---
<define name="branch">
  <band d="M@(190,54) A54 54 0 0 1 @(292,54)" color="$stem" width="2"/>
  <ring n="8" turn="196" span="92">
    <g transform="translate(@(0,54))">
      <ellipse cx="-4" cy="-3.6" rx="3.2" ry="6.4" transform="rotate(-50 -4 -3.6)" fill="$leaf" outline/>
      <ellipse cx="-4" cy="3.6" rx="3.2" ry="6.4" transform="rotate(-130 -4 3.6)" fill="$shade" outline/>
    </g>
  </ring>
</define>

<pair><branch/></pair>
<g transform="translate(60 111)">
  <circle r="8.5" fill="$leaf" outline/>
  <circle r="5.8" fill="none" stroke="$shade" stroke-width="1.4"/>
  <path d="M0 -4.2 L1.2 -1.3 L4.2 -1.2 L1.9 0.8 L2.6 3.8 L0 2.2 L-2.6 3.8 L-1.9 0.8 L-4.2 -1.2 L-1.2 -1.3Z" fill="$ink"/>
</g>
<glint x="108" y="44" r="3.4" delay=".4"/>
<glint x="12" y="44" r="2.6" delay="1.2"/>
