// Amethyst clusters growing out of the rim, each shard pointing away from
// the avatar: a big cluster low on one side, a small one high on the other.
name: Кристаллы
order: 90
$light: #eadfff
$mid: #b89cff
$dark: #7c5cf0
$tip: #f7f2ff
---
<!-- A six-sided shard seen from the side: lit face, shaded face, a dark sliver. -->
<define name="shard" params="lean=0">
  <g transform="translate(@({a},47)) rotate({a + lean})">
    <path d="M{-w/2} 2 L{-w/2} {-len*0.72} L0 {-len} L{w/2} {-len*0.72} L{w/2} 2Z" fill="$mid"/>
    <path d="M{-w/2} 2 L{-w/2} {-len*0.72} L{-w*0.1} {-len*0.94} L{-w*0.1} 2Z" fill="$light"/>
    <path d="M{w*0.28} 2 L{w*0.28} {-len*0.78} L{w/2} {-len*0.72} L{w/2} 2Z" fill="$dark"/>
    <path d="M{-w/2} {-len*0.72} L0 {-len} L{w/2} {-len*0.72} L{-w*0.1} {-len*0.7}Z" fill="$tip"/>
    <path d="M{-w/2} 2 L{-w/2} {-len*0.72} L0 {-len} L{w/2} {-len*0.72} L{w/2} 2" fill="none" outline/>
    <path d="M{-w/2+1.7} -2 V{-len*0.64}" stroke="#fff" stroke-width="1.3" stroke-linecap="round" opacity=".9"/>
  </g>
</define>

<g class="glow" style="--glow: #b89cff">
  <shard a="112" len="14" w="7" lean="-6"/>
  <shard a="124" len="24" w="10" lean="-4"/>
  <shard a="138" len="38" w="14"/>
  <shard a="151" len="27" w="11" lean="5"/>
  <shard a="162" len="16" w="8" lean="8"/>
  <shard a="-52" len="18" w="8" lean="-6"/>
  <shard a="-40" len="27" w="10"/>
  <shard a="-28" len="15" w="7" lean="7"/>
</g>
<glint x="113" y="73" r="4.5" delay=".3"/>
<glint x="96" y="116" r="3" delay="1.2"/>
<glint x="8" y="34" r="3.5" delay=".8"/>
