// Horns on the rim and a tail curling out at the bottom right.
name: Демон
order: 60
$red: #ff4d5e
$deep: #c42f48
---
<pair>
  <g anim="pulse">
    <path d="M@(-54,50) C11 20 12 5 21 -1 C23 8 31 12 @(-20,50) A50 50 0 0 0 @(-54,50)Z" fill="$red" outline/>
    <path d="M@(-53,50) C14 20 14.5 9 19.5 3 C19 11 22 18 28 22Z" fill="$deep"/>
    <path d="M17.5 19q4-1.5 6.5 1M19 10.5q3-1.2 5 .8" fill="none" stroke="$ink" stroke-width="1.5" stroke-linecap="round"/>
  </g>
</pair>
<g anim="sway" class="tail">
  <band d="M88 106C100 114 111 104 107 94C104 87 109 81 113 83" color="$red" width="3.4"/>
  <path d="M111.5 86.5L108 76.5L118.5 79.5Z" fill="$red" outline/>
</g>
