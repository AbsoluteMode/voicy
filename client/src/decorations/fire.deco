// A ring of fire burning along the lower rim: tall tongues up the sides,
// short ones along the bottom, one outline around the whole blaze.
name: Пламя
order: 80
$flame: #ff4f2e
$mid: #ff9a2e
$core: #ffe066
---
<!-- One tongue, pointing up from (0, 0), its tip hooked to the right. -->
<define name="tongue">
  <path fill="{fill}" d="
    M{-w/2} 0
    C{-w*0.62} {-h*0.38} {-w*0.1} {-h*0.52} {-w*0.18} {-h*0.78}
    C{-w*0.22} {-h*0.9} {-w*0.05} {-h*0.98} {w*0.1} {-h}
    C{w*0.02} {-h*0.82} {w*0.3} {-h*0.66} {w*0.42} {-h*0.42}
    C{w*0.52} {-h*0.24} {w*0.5} {-h*0.1} {w/2} 0
    Q0 {w*0.35} {-w/2} 0Z"/>
</define>

<define name="flame" params="rot=0 delay=0">
  <g transform="translate(@({at},50)) rotate({rot})">
    <g anim="flicker" delay="{delay}">
      <tongue h="{h}" w="{w}" fill="$flame"/>
      <g transform="translate(0 1)"><tongue h="{h*0.7}" w="{w*0.64}" fill="$mid"/></g>
      <g transform="translate(0 1.5)"><tongue h="{h*0.4}" w="{w*0.36}" fill="$core"/></g>
    </g>
  </g>
</define>

<define name="half">
  <flame at="270" h="24" w="12" rot="-30" delay=".35"/>
  <flame at="250" h="42" w="18" rot="-16"/>
  <flame at="228" h="32" w="17" rot="-8" delay=".2"/>
  <flame at="205" h="22" w="16" rot="-3" delay=".5"/>
</define>

<sticker>
  <band d="M@(245,51) A51 51 0 0 0 @(115,51)" color="$flame" width="8"/>
  <pair><half/></pair>
  <flame at="180" h="18" w="18" delay=".1"/>
</sticker>
<g fill="$core" stroke="$ink" stroke-width="1.2">
  <path anim="rise" d="M5 50q-3-4 0-8q3 4 0 8Z"/>
  <path anim="rise" delay=".9" d="M115 58q-2.4-3.2 0-6.4q2.4 3.2 0 6.4Z"/>
  <path anim="rise" delay="1.5" d="M12 30q-2-2.7 0-5.4q2 2.7 0 5.4Z"/>
</g>
