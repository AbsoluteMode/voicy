// For the mid players: health and mana over the head, as in any MOBA, and
// a level badge. The mana drains while the owner talks.
name: Мид
order: 160
$hp: #5fd068
$hpdark: #2f7a3a
$mana: #4aa3ff
$frame: #1b1b21
$me: #c6f36b
---
<rect x="26" y="3" width="70" height="15" rx="4" fill="$frame" outline/>
<!-- Health, 80 %, with a tick every tenth. -->
<rect x="29" y="5.6" width="51" height="6" rx="1.5" fill="$hp"/>
<rect x="29" y="9.6" width="51" height="2" rx="1" fill="$hpdark"/>
<path d="M35.4 5.6v6M41.8 5.6v6M48.2 5.6v6M54.6 5.6v6M61 5.6v6M67.4 5.6v6M73.8 5.6v6" stroke="$frame" stroke-width="1"/>
<rect class="mana" x="29" y="13.4" width="64" height="2.6" rx="1.3" fill="$mana"/>
<g transform="translate(22 11)">
  <circle r="9" fill="$frame" outline/>
  <circle r="6.6" fill="none" stroke="$me" stroke-width="1.6"/>
  <text y="3.2" text-anchor="middle" font-family="Unbounded, sans-serif" font-weight="600" font-size="8.5" fill="$me">30</text>
</g>
<glint x="101" y="8" r="3.2" delay=".5" color="#9fd4ff"/>
